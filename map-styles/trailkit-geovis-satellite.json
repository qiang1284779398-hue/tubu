{
  "version": 8,
  "name": "TrailKit Geovis High Resolution Satellite",
  "sources": {
    "geovis": {
      "type": "raster",
      "tiles": [
        "https://api.open.geovisearth.com/pj/base/v1/img/{z}/{x}/{y}?format=webp&tmsIds=w"
      ],
      "tileSize": 256,
      "maxzoom": 18,
      "attribution": "© 中科星图数字地球（星图云影像图 API）"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#e6e3d9" }
    },
    {
      "id": "geovis-satellite-imagery",
      "type": "raster",
      "source": "geovis",
      "minzoom": 0,
      "maxzoom": 18
    }
  ]
}